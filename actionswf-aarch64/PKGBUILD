pkgname=actionswf
pkgver=1.168
pkgrel=0
pkgdesc="Action Swf library"
arch=('aarch64')
url="https://github.com/colin-i/${pkgname}"
license=('0BSD')

package() {
	touch include_dev
	make DESTDIR="$pkgdir/" SUBDIRS="dev oad" install
	cd csrc
	make DESTDIR="$pkgdir/" install
}
